iner {\n    position: relative;\n    max-width: 1000px;\n    margin: 20px auto;\n    border-radius: 4px;\n    overflow: hidden;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    padding: 100px 20px;\n    text-align: center;\n    min-height: 80vh; /* Îi dă înălțime vizuală bună */\n  }\n\n  .lumoir-video-bg {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    z-index: 0;\n  }\n\n  .lumoir-overlay {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    background-color: rgba(0, 0, 0, 0.45);\n    z-index: 1;\n  }\n\n  .lumoir-content {\n    position: relative;\n    z-index: 2;\n    max-width: 600px;\n    width: 100%;\n  }\n\n  /* Stil Logo */\n  .lumoir-logo-wrapper {\n    margin-bottom: 40px;\n  }\n  .lumoir-logo {\n    max-width: 180px; /* Ajustează dimensiunea logo-ului aici */\n    height: auto;\n    filter: brightness(0) invert(1); /* Forțează logo-ul să fie alb dacă e negru */\n  }\n\n  .lumoir-title {\n    font-family: serif;\n    font-size: 36px;\n    color: #ffffff;\n    margin-bottom: 20px;\n    letter-spacing: 1px;\n  }\n  \n  .lumoir-subtitle {\n    font-size: 16px;\n    line-height: 1.6;\n    color: #e5e5e5;\n    margin-bottom: 30px;\n  }\n  \n  .lumoir-message {\n    font-size: 14px;\n    font-weight: 600;\n    color: #ffffff;\n    margin-bottom: 25px;\n    text-transform: uppercase;\n    letter-spacing: 1px;\n  }\n\n  /* Formular */\n  .lumoir-form {\n    display: flex;\n    justify-content: center;\n  }\n  .lumoir-input-group {\n    display: flex;\n    width: 100%;\n    max-width: 450px;\n  }\n  .lumoir-input {\n    flex: 1;\n    padding: 15px;\n    border: none;\n    border-radius: 2px 0 0 2px;\n    outline: none;\n  }\n  .lumoir-button {\n    background-color: #6D573F;\n    color: white;\n    padding: 15px 30px;\n    border: none;\n    border-radius: 0 2px 2px 0;\n    cursor: pointer;\n    font-weight: 600;\n    transition: 0.3s;\n  }\n  .lumoir-button:hover {\n    background-color: #554431;\n  }\n  \n  .lumoir-success {\n    color: #ffffff;\n    margin-top: 15px;\n  }\n\n  /* Ajustare mobil */\n  @media (max-width: 600px) {\n    .lumoir-input-group {\n      flex-direction: column;\n    }\n    .lumoir-input, .lumoir-button {\n      border-radius: 2px;\n      width: 100%;\n    }\n    .lumoir-button {\n      margin-top: 10px;\n    }\n  }\n</style>",
