        "custom_liquid": "<div class=\"lumoir-banner-container\">\n  <video class=\"lumoir-video-bg\" autoplay loop muted playsinline>\n    <source src=\"https://cdn.shopify.com/videos/c/o/v/34dafe6e3b8043138d69410e72694025.mov\" type=\"video/mp4\">\n  </video>\n   \n  <div class=\"lumoir-content\">\n    <div class=\"lumoir-logo-wrapper\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0977/4170/1495/files/lumoir-bronze.png?v=1767879275\" alt=\"Lumoir Studio Logo\" class=\"lumoir-logo\">\n    </div>\n\n    <h1 class=\"lumoir-title\">Pregătim ultimele detalii...</h1>\n    \n    <p class=\"lumoir-subtitle\">\n      Te așteaptă o primă colecție de lumânări premium și decorațiuni unicat din compozit Jesmonite. Fără perfecțiune industrială, dar create cu răbdare în micul nostru atelier.\n    </p>\n    \n    <p class=\"lumoir-message\">\n      Lasă-ne email-ul. Te anunțăm când deschidem și ai -10% la prima comandă.\n    </p>\n\n    {% form 'customer', class: 'lumoir-form' %}\n      {% if form.posted_successfully? %}\n        <p class=\"lumoir-success\">Mulțumim! Te-am adăugat pe listă.</p>\n      {% else %}\n        {{ form.errors | default_errors }}\n        <div class=\"lumoir-input-group\">\n          <input type=\"hidden\" name=\"contact[tags]\" value=\"prospect, coming soon\">\n          <input type=\"email\"\n                 name=\"contact[email]\"\n                 id=\"Email\"\n                 class=\"lumoir-input\"\n                 value=\"{% if customer %}{{ customer.email }}{% endif %}\"\n                 placeholder=\"Adresa ta de email\"\n                 required>\n          <button type=\"submit\" class=\"lumoir-button\">Anunță-mă</button>\n        </div>\n      {% endif %}\n    {% endform %}\n  </div>\n</div>\n\n<style>\n  .lumoir-banner-container {\n    position: relative;\n    max-width: 1000px;\n    margin: 20px auto;\n    border-radius: 4px;\n    overflow: hidden;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    padding: 100px 20px;\n    text-align: center;\n    min-height: 80vh;\n    background-color: #000;\n  }\n\n  /* ACESTA ESTE OVERLAY-UL - creat direct din container */\n  .lumoir-banner-container::after {\n    content: \"\";\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    background-color: rgba(0, 0, 0, 0.6) !important; /* Negru 40% opacitate */\n    z-index: 1;\n    display: block !important;\n  }\n\n  .lumoir-video-bg {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    z-index: 0;\n  }\n\n  .lumoir-content {\n    position: relative;\n    z-index: 2; /* Peste overlay (z-index 1) */\n    max-width: 600px;\n    width: 100%;\n  }\n\n  .lumoir-logo-wrapper { margin-bottom: 40px; }\n  .lumoir-logo { max-width: 180px; height: auto; filter: brightness(0) invert(1); }\n  .lumoir-title { font-family: serif; font-size: 36px; color: #ffffff; margin-bottom: 20px; letter-spacing: 1px; }\n  .lumoir-subtitle { font-size: 16px; line-height: 1.6; color: #e5e5e5; margin-bottom: 30px; }\n  .lumoir-message { font-size: 14px; font-weight: 600; color: #ffffff; margin-bottom: 25px; text-transform: uppercase; letter-spacing: 1px; }\n\n  .lumoir-form { display: flex; justify-content: center; }\n  .lumoir-input-group { display: flex; width: 100%; max-width: 450px; }\n  .lumoir-input { flex: 1; padding: 15px; border: none; border-radius: 2px 0 0 2px; outline: none; }\n  .lumoir-button { background-color: #6D573F; color: white; padding: 15px 30px; border: none; border-radius: 0 2px 2px 0; cursor: pointer; font-weight: 600; transition: 0.3s; }\n  .lumoir-button:hover { background-color: #554431; }\n  .lumoir-success { color: #ffffff; margin-top: 15px; }\n\n  @media (max-width: 600px) {\n    .lumoir-input-group { flex-direction: column; }\n    .lumoir-input, .lumoir-button { border-radius: 2px; width: 100%; }\n    .lumoir-button { margin-top: 10px; }\n  }\n</style>",
