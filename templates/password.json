n-items: center;\n    padding: 80px 20px;\n    text-align: center;\n  }\n\n  .lumoir-video-bg {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    z-index: 0;\n  }\n\n  .lumoir-overlay {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    background-color: rgba(0, 0, 0, 0.4); /* Întunecă videoul cu 40% */\n    z-index: 1;\n  }\n\n  .lumoir-content {\n    position: relative;\n    z-index: 2;\n    max-width: 550px;\n    width: 100%;\n  }\n\n  .lumoir-title {\n    font-family: \"Playfair Display\", \"Times New Roman\", serif;\n    font-size: 32px;\n    font-weight: 400;\n    color: #ffffff; /* Text alb */\n    margin-bottom: 24px;\n    letter-spacing: 0.5px;\n  }\n  \n  .lumoir-subtitle {\n    font-family: \"Helvetica Neue\", Helvetica, Arial, sans-serif;\n    font-size: 15px;\n    line-height: 1.6;\n    color: #f0f0f0;\n    margin-bottom: 30px;\n  }\n  \n  .lumoir-message {\n    font-family: \"Helvetica Neue\", Helvetica, Arial, sans-serif;\n    font-size: 14px;\n    font-weight: 600;\n    color: #ffffff;\n    margin-bottom: 20px;\n  }\n  \n  .lumoir-form {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    width: 100%;\n  }\n  \n  .lumoir-input-group {\n    display: flex;\n    flex-direction: column;\n    width: 100%;\n    max-width: 420px;\n    gap: 12px;\n  }\n  \n  @media (min-width: 600px) {\n    .lumoir-input-group {\n      flex-direction: row;\n      gap: 0;\n    }\n  }\n  \n  .lumoir-input {\n    flex-grow: 1;\n    padding: 14px 16px;\n    border: none;\n    border-radius: 4px;\n    font-size: 14px;\n    font-family: inherit;\n    outline: none;\n    background-color: rgba(255, 255, 255, 0.95);\n  }\n  \n  @media (min-width: 600px) {\n    .lumoir-input {\n      border-radius: 4px 0 0 4px;\n    }\n  }\n  \n  .lumoir-button {\n    background-color: #6D573F;\n    color: #ffffff;\n    border: none;\n    padding: 14px 28px;\n    