-grid\">\n<section class=\"ljc-story\" aria-labelledby=\"ljc-heading\">\n<div class=\"ljc-brand\">{% if settings.logo != blank %}{{ settings.logo | image_url: width: 240 | image_tag: alt: 'Lumoir Studio', loading: 'lazy' }}{% else %}Lumoir Studio{% endif %}</div>\n<h1 id=\"ljc-heading\">Calculator Jesmonite</h1>\n<p class=\"ljc-intro\">De la idee la cantitatea potrivită. Pregătește exact cât amestec ai nevoie pentru creația ta.</p>\n<div class=\"ljc-photo\"><img src=\"https://cdn.shopify.com/s/files/1/0977/4170/1495/files/earthy-pine-tray-marble-product_8.jpg?v=1794036814\" alt=\"Tavă decorativă în formă de brad, cu aspect marmorat, realizată manual și ținută în palme\" loading=\"lazy\" width=\"900\" height=\"1100\"></div>\n</section>\n<section class=\"ljc-panel\" aria-labelledby=\"ljc-calc-title\">\n<h2 id=\"ljc-calc-title\">Calculează amestecul</h2><p class=\"ljc-caption\">Introdu orice cantitate; celelalte valori se actualizează automat.</p>\n<div class=\"ljc-product\"><label for=\"ljc-product\">Produs</label><select id=\"ljc-product\" data-product><option value=\"AC100\">AC100</option><option value=\"AC730\">AC730</option></select></div>\n<p class=\"ljc-ratio\" data-ratio>Raport pulbere/lichid 2,5:1 · factor apă 1,75</p>\n<div class=\"ljc-fields\">\n<div class=\"ljc-pair\"><div><label for=\"ljc-powder\">Pulbere (g)</label><input id=\"ljc-powder\" data-field=\"powder\" type=\"text\" inputmode=\"decimal\" placeholder=\"0,00\" autocomplete=\"off\" aria-describedby=\"ljc-error\"></div><span class=\"ljc-plus\" aria-hidden=\"true\">+</span><div><label for=\"ljc-liquid\">Lichid (g)</label><input id=\"ljc-liquid\" data-field=\"liquid\" type=\"text\" inputmode=\"decimal\" placeholder=\"0,00\" autocomplete=\"off\" aria-describedby=\"ljc-error\"></div></div>\n<div class=\"ljc-total\"><label for=\"ljc-total\">Amestec total (g)</label><input id=\"ljc-total\" data-field=\"total\" type=\"text\" inputmode=\"decimal\" placeholder=\"0,00\" autocomplete=\"off\" aria-describedby=\"ljc-error\"></div>\n<div class=\"ljc-water\"><label for=\"ljc-water\">Apă în matriță (g)</label><input id=\"ljc-water\" data-field=\"water\" type=\"text\" inputmode=\"decimal\" placeholder=\"0,00\" autocomplete=\"off\" aria-describedby=\"ljc-help ljc-error\"><p class=\"ljc-help\" id=\"ljc-help\">Cântărește matrița goală, adu cântarul la zero și umple-o cu apă până la nivelul de turnare. Introdu masa apei.</p></div>\n</div>\n<p class=\"ljc-error\" data-error id=\"ljc-error\" role=\"alert\" aria-live=\"polite\"></p>\n<button class=\"ljc-reset\" type=\"button\" data-reset>Resetează</button>\n<p class=\"ljc-note\">Cantitățile sunt orientative. Verifică instrucțiunile producătorului pentru materialul folosit.</p>\n</section>\n</div>\n<script>\n(()=>{const root=document.querySelector('#shopify-section-template--27502807253367__custom_liquid_cVNYbV [data-ljc]');if(!root||root.dataset.ljcBound==='true')return;root.dataset.ljcBound='true';const inputs=Object.fromEntries([...root.querySelectorAll('[data-field]')].map(el=>[el.dataset.field,el])),product=root.querySelector('[data-product]'),error=root.querySelector('[data-error]'),ratio=root.querySelector('[data-ratio]');let busy=false;\nconst params=()=>product.value==='AC100'?{r:2.5,f:1.75}:{r:5,f:1.95};const setRatio=()=>{const {r,f}=params();ratio.textContent=`Raport pulbere/lichid ${String(r).replace('.',',')}:1 · factor apă ${String(f).replace('.',',')}`};\nconst parse=s=>{const v=s.trim();if(v==='')return{kind:'blank'};if(!/^(?:\\d+(?:[.,]\\d*)?|[.,]\\d+)$/.test(v))return{kind:'invalid'};const n=Number(v.replace(',','.'));return Number.isFinite(n)&&n>=0?{kind:'valid',value:n}:{kind:'invalid'}};\nconst fmt=n=>{if(!Number.isFinite(n))return'';const v=Math.round((n+Number.EPSILON)*100)/100;return String(Object.is(v,-0)?0:v)};\nroot.addEventListener('input',e=>{const source=e.target.closest('[data-field]');if(!source||busy)return;const kind=source.dataset.field,p=parse(source.value);if(p.kind!=='valid'){error.textContent=p.kind==='invalid'?'Introdu o valoare numerică validă, egală cu zero sau mai mare.':'';for(const[key,el]of Object.entries(inputs))if(key!==kind)el.value='';return}error.textContent='';const{r,f}=params();let powder,liquid,total,water;switch(kind){case'water':water=p.value;total=water*f;powder=total*r/(r+1);liquid=total/(r+1);break;case'total':total=p.value;liquid=total/(r+1);powder=total*r/(r+1);water=total/f;break;case'powder':powder=p.value;liquid=powder/r;total=powder+liquid;water=total/f;break;case'liquid':liquid=p.value;powder=liquid*r;total=liquid+powder;water=total/f;break}busy=true;for(const[key,val]of Object.entries({powder,liquid,total,water}))if(key!==kind)inputs[key].value=fmt(val);busy=false});\nproduct.addEventListener('change',()=>{Object.values(inputs).forEach(el=>el.value='');error.textContent='';setRatio()});root.querySelector('[data-reset]').addEventListener('click',()=>{Object.values(inputs).forEach(el=>el.value='');product.value='AC100';error.textContent='';setRatio();inputs.powder.focus()});setRatio()})();\n</script>\n</div>\n{% endif %}",
