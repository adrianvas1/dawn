rror\" role=\"alert\" aria-live=\"polite\"></p>\n<p class=\"ljc-note\">Cantitățile sunt orientative. Verifică instrucțiunile producătorului pentru materialul folosit.</p>\n<button class=\"ljc-reset\" type=\"button\" data-reset>Resetează</button>\n</section>\n<div class=\"ljc-photo\"><img src=\"https://cdn.shopify.com/s/files/1/0977/4170/1495/files/jesmonite-technical-b4c94f15.png?v=1795201708\" alt=\"Ilustrație tehnică a amestecării și turnării compozitului într-o matriță\" loading=\"lazy\" width=\"1024\" height=\"1024\"></div>\n</div>\n<script>\n(()=>{const root=document.querySelector('#shopify-section-template--27502807253367__custom_liquid_cVNYbV [data-ljc]');if(!root||root.dataset.ljcBound==='true')return;root.dataset.ljcBound='true';const inputs=Object.fromEntries([...root.querySelectorAll('[data-field]')].map(el=>[el.dataset.field,el])),product=root.querySelector('[data-product]'),error=root.querySelector('[data-error]'),pigment=root.querySelector('[data-pigment]');let busy=false;\nconst params=()=>product.value==='AC100'?{r:2.5,f:1.75}:{r:5,f:1.95};const parse=s=>{const v=s.trim();if(v==='')return{kind:'blank'};if(!/^(?:\\d+(?:[.,]\\d*)?|[.,]\\d+)$/.test(v))return{kind:'invalid'};const n=Number(v.replace(',','.'));return Number.isFinite(n)&&n>=0?{kind:'valid',value:n}:{kind:'invalid'}};const fmt=n=>{if(!Number.isFinite(n))return'';const v=Math.round((n+Number.EPSILON)*100)/100;return String(Object.is(v,-0)?0:v)};\nconst updatePigment=total=>{if(product.value==='AC100'&&Number.isFinite(total)&&total>0){pigment.textContent=`🎨 Poți adăuga maximum ${fmt(total*.02)} g de pigment Jesmonite.`;pigment.hidden=false}else{pigment.textContent='';pigment.hidden=true}};\nroot.addEventListener('input',e=>{const source=e.target.closest('[data-field]');if(!source||busy)return;const kind=source.dataset.field,p=parse(source.value);if(p.kind!=='valid'){error.textContent=p.kind==='invalid'?'Introdu o valoare numerică validă, egală cu zero sau mai mare.':'';for(const[key,el]of Obj