        "custom_liquid": "{% if request.page_type == 'page' and page.handle == 'calculator-jesmonite' %}\n<div id=\"lumoir-calc-{{ section.id }}\" class=\"lumoir-calc\">\n  <div class=\"lumoir-calc__intro\">\n    <h1>Calculator Jesmonite</h1>\n    <p>De la idee la cantitatea potrivită.</p>\n    <p>\n      Introdu o cantitate în oricare dintre câmpuri.\n      Restul valorilor se calculează automat.\n    </p>\n    <details>\n      <summary>Cum măsor matrița?</summary>\n      <p>\n        Cântărește matrița goală, adu cântarul la zero și\n        umple-o cu apă până la nivelul de turnare.\n        Introdu masa apei în câmpul „Apă în matriță”.\n      </p>\n    </details>\n  </div>\n\n  <div class=\"lumoir-calc__panel\">\n    <label for=\"material-{{ section.id }}\">Material</label>\n    <select id=\"material-{{ section.id }}\" data-material>\n      <option value=\"ac100\">Jesmonite AC100</option>\n      <option value=\"ac730\">Jesmonite AC730</option>\n    </select>\n\n    <div class=\"lumoir-calc__grid\">\n      <div>\n        <label for=\"powder-{{ section.id }}\">Pulbere (g)</label>\n        <input id=\"powder-{{ section.id }}\"\n          data-quantity=\"powder\" type=\"text\"\n          inputmode=\"decimal\" autocomplete=\"off\">\n      </div>\n      <div>\n        <label for=\"liquid-{{ section.id }}\">Lichid (g)</label>\n        <input id=\"liquid-{{ section.id }}\"\n          data-quantity=\"liquid\" type=\"text\"\n          inputmode=\"decimal\" autocomplete=\"off\">\n      </div>\n      <div>\n        <label for=\"total-{{ section.id }}\">Amestec total (g)</label>\n        <input id=\"total-{{ section.id }}\"\n          data-quantity=\"total\" type=\"text\"\n          inputmode=\"decimal\" autocomplete=\"off\">\n      </div>\n      <div>\n        <label for=\"water-{{ section.id }}\">Apă în matriță (g)</label>\n        <input id=\"water-{{ section.id }}\"\n          data-quantity=\"water\" type=\"text\"\n          inputmode=\"decimal\" autocomplete=\"off\">\n      </div>\n    </div>\n\n    <p class=\"lumoir-calc__equation\">Pulbere + lichid = amestec total</p>\n    <p data-error role=\"status\" class=\"lumoir-calc__error\"></p>\n    <button type=\"button\" data-reset>Resetează</button>\n    <p class=\"lumoir-calc__note\">\n      Cantitățile sunt orientative. Verifică instrucțiunile\n      producătorului pentru materialul folosit.\n    </p>\n  </div>\n</div>\n\n<style>\n  #lumoir-calc-{{ section.id }} {\n    --lc-bg: #f7f5f2;\n    --lc-text: #2d2926;\n    --lc-accent: #594733;\n    display: grid;\n    grid-template-columns: 1fr 1.2fr;\n    gap: 48px;\n    max-width: 1000px;\n    margin: 32px auto;\n    padding: 40px;\n    background: var(--lc-bg);\n    color: var(--lc-text);\n    box-sizing: border-box;\n  }\n  #lumoir-calc-{{ section.id }} * { box-sizing: border-box; }\n  #lumoir-calc-{{ section.id }} h1 {\n    margin: 0 0 20px;\n    color: inherit;\n    font-size: clamp(28px, 4vw, 42px);\n  }\n  #lumoir-calc-{{ section.id }} p {\n    line-height: 1.65;\n  }\n  #lumoir-calc-{{ section.id }} .lumoir-calc__panel {\n    min-width: 0;\n  }\n  #lumoir-calc-{{ section.id }} label {\n    display: block;\n    margin-bottom: 8px;\n    font-size: 14px;\n    font-weight: 600;\n  }\n  #lumoir-calc-{{ section.id }} input,\n  #lumoir-calc-{{ section.id }} select {\n    width: 100%;\n    min-height: 48px;\n    padding: 12px;\n    border: 1px solid #857765;\n    border-radius: 4px;\n    background: #fff;\n    color: var(--lc-text);\n    font: inherit;\n    font-size: 16px;\n  }\n  #lumoir-calc-{{ section.id }} .lumoir-calc__grid {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 20px;\n    margin-top: 24px;\n  }\n  #lumoir-calc-{{ section.id }} button {\n    min-height: 46px;\n    padding: 12px 24px;\n    border: 1px solid var(--lc-accent);\n    border-radius: 4px;\n    background: var(--lc-accent);\n    color: #fff;\n    cursor: pointer;\n    font: inherit;\n  }\n  #lumoir-calc-{{ section.id }} :is(input, select, button, summary):focus-visible {\n    outline: 2px solid var(--lc-accent);\n    outline-offset: 4px;\n  }\n  #lumoir-calc-{{ section.id }} summary {\n    cursor: pointer;\n    text-decoration: underline;\n    text-underline-offset: 4px;\n  }\n  #lumoir-calc-{{ section.id }} .lumoir-calc__note,\n  #lumoir-calc-{{ section.id }} .lumoir-calc__equation {\n    font-size: 13px;\n  }\n  #lumoir-calc-{{ section.id }} .lumoir-calc__error {\n    color: #9b2424;\n    font-size: 14px;\n  }\n  #lumoir-calc-{{ section.id }} .lumoir-calc__error:empty {\n    display: none;\n  }\n  @media (max-width: 749px) {\n    #lumoir-calc-{{ section.id }} {\n      grid-template-columns: 1fr;\n      gap: 28px;\n      margin: 16px;\n      padding: 24px;\n    }\n  }\n  @media (max-width: 360px) {\n    #lumoir-calc-{{ section.id }} .lumoir-calc__grid {\n      grid-template-columns: 1fr;\n    }\n  }\n</style>\n\n<script>\n(function () {\n  const rootId = 'lumoir-calc-{{ section.id }}';\n\n  function init() {\n    const root = document.getElementById(rootId);\n    if (!root || root.dataset.initialized) return;\n    root.dataset.initialized = 'true';\n\n    const material = root.querySelector('[data-material]');\n    const fields = Array.from(root.querySelectorAll('[data-quantity]'));\n    const error = root.querySelector('[data-error]');\n    const format = new Intl.NumberFormat('ro-RO', {\n      maximumFractionDigits: 2,\n      useGrouping: false\n    });\n\n    // Parametri recuperați din specificațiile calculatorului anterior.\n    const materials = {\n      ac100: { ratio: 2.5, factor: 1.75 },\n      ac730: { ratio: 5, factor: 1.95 }\n    };\n\n    function clearOthers(active) {\n      fields.forEach(function (field) {\n        if (field !== active) field.value = '';\n      });\n    }\n\n    function reset() {\n      fields.forEach(function (field) {\n        field.value = '';\n        field.removeAttribute('aria-invalid');\n      });\n      error.textContent = '';\n    }\n\n    fields.forEach(function (active) {\n      active.addEventListener('input', function () {\n        error.textContent = '';\n        fields.forEach(function (field) {\n          field.removeAttribute('aria-invalid');\n        });\n\n        const raw = active.value.trim().replace(',', '.');\n        if (raw === '') {\n          clearOthers(active);\n          return;\n        }\n\n        const value = Number(raw);\n        if (!/^(?:\\d+(?:\\.\\d*)?|\\.\\d+)$/.test(raw) ||\n            !Number.isFinite(value) || value < 0) {\n          clearOthers(active);\n          active.setAttribute('aria-invalid', 'true');\n          error.textContent = 'Introdu o cantitate validă, mai mare sau egală cu zero.';\n          return;\n        }\n\n        const settings = materials[material.value];\n        const ratio = settings.ratio;\n        const factor = settings.factor;\n        let total;\n\n        switch (active.dataset.quantity) {\n          case 'powder':\n            total = value + value / ratio;\n            break;\n          case 'liquid':\n            total = value * (ratio + 1);\n            break;\n          case 'water':\n            total = value * factor;\n            break;\n          default:\n            total = value;\n        }\n\n        const values = {\n          powder: total * ratio / (ratio + 1),\n          liquid: total / (ratio + 1),\n          total: total,\n          water: total / factor\n        };\n\n        if (!Object.values(values).every(Number.isFinite)) {\n          clearOthers(active);\n          active.setAttribute('aria-invalid', 'true');\n          error.textContent = 'Cantitatea este prea mare. Introdu o valoare mai mică.';\n          return;\n        }\n\n        fields.forEach(function (field) {\n          if (field !== active) {\n            field.value = format.format(values[field.dataset.quantity]);\n          }\n        });\n      });\n    });\n\n    material.addEventListener('change', reset);\n    root.querySelector('[data-reset]').addEventListener('click', reset);\n  }\n\n  init();\n  document.addEventListener('shopify:section:load', init);\n})();\n</script>\n{% endif %}",
